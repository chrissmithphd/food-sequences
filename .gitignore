# Data files - never commit raw or processed datasets
data/raw/**
data/processed/**
*.csv
*.parquet

# EXCEPT: example data files showing schema (synthetic data)
!data/examples/*.csv
*.zip
*.gz
*.tar
*.tar.gz

# Keep data directory structure but ignore contents
!data/raw/.gitkeep
!data/processed/.gitkeep

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
env/
ENV/
.venv/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Credentials - NEVER commit
.kaggle/
kaggle.json
.env
*.key
*.pem

# Testing
.pytest_cache/
.coverage
htmlcov/

# Logs
*.log

# Temporary files
tmp/
temp/
*.tmp

# Claude Code plans and working artifacts
.claude/plans/
.claude/workspaces/

# Analysis outputs (large parquet files - figures are kept)
analysis/outputs/*.parquet
analysis/outputs/*.csv

# EXCEPT: Classification results (product-level, no customer IDs)
!analysis/classification/food_classification.csv
!analysis/classification/methods_compared/*.csv
!analysis/classification/archived/*.csv

# EXCEPT: Sequence analysis summaries (aggregate statistics only, no user IDs)
!analysis/sequence_analysis/reorder_summary.csv
!analysis/sequence_analysis/basket_composition_summary.csv
!analysis/sequence_analysis/pattern_distribution.csv
!analysis/sequence_analysis/prepared_vs_base.csv
!analysis/sequence_analysis/top_ingredients_by_volume.csv
!analysis/sequence_analysis/ingredient_lens_summary.csv
!analysis/sequence_analysis/reorder_probability_audit.csv
