# Data files - never commit raw or processed datasets
data/raw/**
data/processed/**
*.csv
*.parquet

# EXCEPT: example data files showing schema (synthetic data)
!data/examples/*.csv
*.zip
*.gz
*.tar
*.tar.gz

# Keep data directory structure but ignore contents
!data/raw/.gitkeep
!data/processed/.gitkeep

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
env/
ENV/
.venv/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Credentials - NEVER commit
.kaggle/
kaggle.json
.env
*.key
*.pem

# Testing
.pytest_cache/
.coverage
htmlcov/

# Logs
*.log

# Temporary files
tmp/
temp/
*.tmp

# Claude Code plans and working artifacts
.claude/plans/
.claude/workspaces/

# Analysis outputs (large parquet files - figures are kept)
analysis/outputs/*.parquet
analysis/outputs/*.csv

# EXCEPT: small aggregate / product-catalog tables meant for review (no customer IDs)

# Food-classification pilot artifacts are product-level (no customer IDs) and meant for review

!analysis/outputs/food_mapping.csv
!analysis/outputs/food_mapping_review_sample.csv
!analysis/outputs/food_classification_refined.csv
!analysis/outputs/food_classification_embeddings.csv
