{
  "catalog_version": "v3.0",
  "note": "Shared recipe-equivalence group catalog. Members of a group are usually interchangeable in the same recipe role. role_family connects related groups without asserting equivalence.",
  "groups": {
    "tomato_fresh": {"role_family": "vegetables", "definition": "fresh tomatoes of any variety (grape, cherry, roma, beefsteak)", "include": ["Grape Tomatoes", "Organic Grape Tomatoes", "Roma Tomato"], "exclude": ["canned/crushed tomatoes", "tomato ketchup", "sun-dried tomato"]},
    "grapes": {"role_family": "fruit", "definition": "table grapes eaten as fruit", "include": ["Seedless Red Grapes"], "exclude": ["grape tomatoes (a tomato)", "grape juice", "grape jelly"]},
    "leafy_green": {"role_family": "vegetables", "definition": "leafy salad/cooking greens", "include": ["Organic Baby Spinach", "kale", "romaine"], "exclude": ["spinach-filled pasta (filling)"]},
    "onion": {"role_family": "vegetables_aromatics", "definition": "fresh onions/shallots/scallions", "include": ["Organic Yellow Onion", "Yellow Onions"], "exclude": ["onion powder", "onion-flavored snacks"]},
    "garlic": {"role_family": "vegetables_aromatics", "definition": "fresh garlic", "include": ["Organic Garlic"], "exclude": ["garlic powder/salt", "garlic bread", "garlic-flavored crackers (flavor)"]},
    "carrot": {"role_family": "vegetables", "definition": "fresh carrots including baby carrots", "include": ["Carrots", "Organic Baby Carrots"], "exclude": ["carrot juice", "carrot cake"]},
    "cucumber": {"role_family": "vegetables", "definition": "fresh cucumbers", "include": ["Cucumber Kirby", "Organic Cucumber"], "exclude": ["pickles"]},
    "cauliflower": {"role_family": "vegetables", "definition": "fresh cauliflower", "include": ["Fresh Cauliflower"], "exclude": ["cauliflower pizza crust (a prepared product)"]},
    "zucchini": {"role_family": "vegetables", "definition": "zucchini / summer squash", "include": ["Organic Zucchini"], "exclude": ["winter/spaghetti squash"]},
    "winter_squash": {"role_family": "vegetables", "definition": "winter squashes incl spaghetti squash, butternut, acorn", "include": ["Organic Spaghetti Squash"], "exclude": ["pasta (spaghetti squash is a vegetable, not pasta)"]},
    "raspberries": {"role_family": "fruit", "definition": "fresh raspberries", "include": ["Organic Raspberries"], "exclude": []},
    "blueberries": {"role_family": "fruit", "definition": "fresh blueberries", "include": ["Organic Blueberries"], "exclude": []},
    "milk": {"role_family": "dairy", "definition": "cow dairy milk of any fat level (whole/2%/1%/skim); fat is an attribute", "include": ["Organic Whole Milk", "2% Reduced Fat Milk", "Fat Free Milk"], "exclude": ["plant milk", "buttermilk", "eggnog", "condensed milk"]},
    "cooking_stock_broth": {"role_family": "cooking_liquids", "definition": "stock, broth, bouillon used as a cooking base; protein is an attribute", "include": ["Organic Chicken Broth", "Organic Chicken Stock", "Organic Vegetable Broth"], "exclude": ["soup (a finished dish)"]},
    "olive_oil": {"role_family": "oils", "definition": "olive oil incl extra virgin", "include": ["Extra Virgin Olive Oil", "Italian Extra Virgin Olive Oil"], "exclude": ["mayonnaise made with olive oil (product is mayonnaise)"]},
    "cooking_oil": {"role_family": "oils", "definition": "neutral cooking oils (canola, vegetable, grapeseed)", "include": ["Canola Oil"], "exclude": ["olive oil (own group)"]},
    "vinegar": {"role_family": "condiments", "definition": "vinegars", "include": ["Apple Cider Vinegar"], "exclude": ["vinaigrette dressing"]},
    "ketchup": {"role_family": "condiments", "definition": "tomato ketchup", "include": ["Organic Ketchup", "Tomato Ketchup"], "exclude": ["tomato paste/sauce", "fresh tomato"]},
    "mustard": {"role_family": "condiments", "definition": "prepared mustard", "include": ["Organic Dijon Mustard"], "exclude": ["mustard greens", "mustard seed spice"]},
    "mayonnaise": {"role_family": "condiments", "definition": "mayonnaise; added oils/flavors are ingredients, not the product", "include": ["Real Mayonnaise", "Organic Mayonnaise with Olive Oil"], "exclude": ["olive oil"]},
    "hot_sauce": {"role_family": "condiments", "definition": "hot/chili sauces", "include": ["Original Hot Sauce"], "exclude": ["salsa"]},
    "crackers": {"role_family": "snacks", "definition": "savory crackers of any flavor/base; flavor words (cheddar, garlic) are attributes", "include": ["Cheddar Bunnies Snack Crackers", "Almond Nut Thins", "Black Bean with Onion & Garlic Crackers"], "exclude": ["rice cakes", "chips"]},
    "rice_cakes": {"role_family": "snacks", "definition": "puffed rice cakes", "include": ["Organic Lightly Salted Brown Rice Cakes"], "exclude": ["rice crackers (crackers)"]},
    "filled_pasta": {"role_family": "pasta_and_dishes", "definition": "stuffed pasta (ravioli, tortellini); the filling (ricotta, spinach, mushroom) is a filling, not the product", "include": ["Cheese Ravioli", "Three Cheese Tortellini", "Spinach And Ricotta Ravioli"], "exclude": ["loose cheese", "plain pasta"]},
    "pasta": {"role_family": "pasta_and_dishes", "definition": "plain dry/fresh pasta you cook; shape is an attribute", "include": ["Gluten Free Linguini", "Spaghetti"], "exclude": ["filled pasta", "mac and cheese kit"]},
    "boxed_mac_and_cheese": {"role_family": "pasta_and_dishes", "definition": "shelf-stable macaroni-and-cheese kits (pasta + cheese sauce/powder)", "include": ["Shells & Real Aged Cheddar Macaroni & Cheese", "Organic Shells And White Cheddar"], "exclude": ["plain pasta", "loose cheese"]},
    "couscous": {"role_family": "grains", "definition": "couscous; flavor words are attributes", "include": ["Garlic Couscous"], "exclude": ["pasta"]},
    "corn_dog": {"role_family": "prepared_dish", "definition": "battered/breaded sausage-on-stick snack (human food)", "include": ["Chicken Corn Dog"], "exclude": ["pet food", "raw sausage"]},
    "OUT_OF_SCOPE_pet_food": {"role_family": "non_food", "definition": "pet food and treats", "include": ["Small Dog Biscuits", "Beef Jerky Dog Treat"], "exclude": ["human corn dog"]},
    "OUT_OF_SCOPE_personal_care": {"role_family": "non_food", "definition": "skin/body/baby personal-care products", "include": ["Calendula Baby Diaper Care", "Facial Scrub", "Hand Sanitizer"], "exclude": []}
  }
}
